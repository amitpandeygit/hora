    "section_2_2_1": {
      "applies_to_native": "Because we are all part of the Supreme energy governing this world, the above mapping applies to us too.",
      "zodiac_as_vishnu": "The whole zodiac is nothing but a manifestation of Lord Vishnu's body."
    },
    "section_2_2_10": {
