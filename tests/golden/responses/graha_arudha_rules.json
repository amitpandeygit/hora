    "section": "9.5 Computation of Graha Arudhas",
    "steps": [
      {
        "name": "graha_sign",
        "number": 1,
        "text": "Take the sign containing the planet of interest in the divisional chart of interest."
      },
      {
        "name": "owned_sign",
        "number": 2,
        "text": "Find the sign owned by that planet."
      },
      {
        "name": "count_to_owned",
        "number": 3,
        "text": "Count signs from the sign containing the planet of interest to the stronger sign owned by it. Counting is in the zodiacal direction always."
      },
      {
        "name": "advance_from_owned",
        "number": 4,
        "text": "Count the same number of signs from the stronger sign owned and find the ending sign."
      },
      {
        "name": "apply_exception",
        "number": 5,
        "text": "Exception: If the sign found thus in step (4) is in the 1st or 7th from the original sign containing the planet, then we take the 10th sign from the sign found in step (4). Otherwise we don't make any change."
      },
      {
        "name": "graha_arudha",
        "number": 6,
        "text": "The resulting sign contains the arudha pada of the planet of interest."
      }
